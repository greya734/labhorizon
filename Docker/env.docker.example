# Copier ce fichier en .env.docker (ou l'utiliser directement avec `docker compose --env-file`)
# APP_KEY : générer avec `php artisan key:generate --show` puis coller ici (format base64:...)
APP_KEY=

APP_URL=http://localhost:8080

DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Laisser vide si pas de mot de passe Redis (dev/staging) ; sinon renseigner ici
REDIS_PASSWORD=

# Nom de la queue dédiée au traitement asynchrone des PDF
# (à utiliser dans tes Jobs avec ->onQueue('pdf-processing'))
PDF_QUEUE_NAME=pdf-processing
